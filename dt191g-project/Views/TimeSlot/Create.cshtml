@model dt191g_project.Models.TimeSlot

@{
    ViewData["Title"] = "Skapa tidslucka";
}

<h1>Skapa tidslucka</h1>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <input type="hidden" asp-for="CompanyId" />

            <div class="form-group mb-3">
                <label class="form-label">Tjänst</label>
                <select asp-for="ServiceId" class="form-control" asp-items="@(new SelectList(ViewBag.Services ?? new List<dt191g_project.Models.Service>(), "Id", "Title"))">
                    <option value="">-- Välj tjänst --</option>
                </select>
                <span asp-validation-for="ServiceId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StartTime" class="form-label">Starttid</label>
                <input asp-for="StartTime" class="form-control" type="datetime-local" min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EndTime" class="form-label">Sluttid</label>
                <input asp-for="EndTime" class="form-control" type="datetime-local" min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>

            <div class="form-group form-check mb-3">
                <input class="form-check-input" asp-for="IsBooked" />
                <label class="form-check-label" asp-for="IsBooked">Är tidsluckan bokad?</label>
            </div>

            <div class="form-group">
                <input type="submit" value="Skapa tidslucka" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" asp-route-companyId="@Model?.CompanyId" class="btn btn-secondary">Tillbaka till listan</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}