
@model dt191g_project.Models.CompanyRegistrationModel

<h2>Registrera Företag</h2>

<form asp-action="Index" method="post">

    <div class="form-group">
        <label>Företagsnamn:</label>
        <input asp-for="CompanyName" class="form-control" />
    </div>

    <div class="form-group">
        <label>Beskrivning:</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label>Adress:</label>
        <input asp-for="Address" class="form-control" />
    </div>

    <div class="form-group">
        <label>Stad:</label>
        <input asp-for="City" class="form-control" />
    </div>

    <div class="form-group">
        <label>Telefonnummer:</label>
        <input asp-for="PhoneNumber" class="form-control" />
    </div>

    <div class="form-group">
        <label>E‑post:</label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="form-group">
        <label>Kategori:</label>
        <input asp-for="Category" class="form-control" />
    </div>

    <div class="form-group">
        <label>Öppettider:</label>
        <input asp-for="OpeningsHours" class="form-control" />
    </div>

    <button class="btn btn-primary mt-3">Registrera företag</button>
</form>
