@model dt191g_project.Models.Booking

@{
    ViewData["Title"] = "Ta bort bokning";
}

<h1 class="text-danger">Ta bort bokning</h1>
<p class="lead">Är du säker på att du vill ta bort denna bokning från systemet?</p>
<hr />

<div class="row">
    <div class="col-md-8">
        <div class="card border-danger shadow-sm mb-4">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Kundnamn</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.CustomerName)</dd>

                    <dt class="col-sm-4">E-post</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.CustomerEmail)</dd>

                    <dt class="col-sm-4">Tjänst</dt>
                    <dd class="col-sm-8">@(Model.Service?.Title ?? "Ej angiven")</dd>

                    <dt class="col-sm-4">Tidslucka</dt>
                    <dd class="col-sm-8">
                        @(Model.TimeSlot != null
                            ? $"{Model.TimeSlot.StartTime:yyyy-MM-dd HH:mm} - {Model.TimeSlot.EndTime:HH:mm}"
                            : "N/A")
                    </dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-secondary">@Model.Status</span>
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-light">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">Bekräfta borttagning</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Avbryt</a>
                </form>
            </div>
        </div>
    </div>
</div>