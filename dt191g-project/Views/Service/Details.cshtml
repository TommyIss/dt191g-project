@model dt191g_project.Models.Service

@{
    ViewData["Title"] = "Tjänstdetaljer";
}

<h1>Tjänstdetaljer</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
           Titel
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class = "col-sm-2">
            Beskrivning
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            Varaktighet (minuter)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DurationMinutes) minuter
        </dd>
        <dt class = "col-sm-2">
            Pris (kr)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Price) Kr
        </dd>
        <dt class = "col-sm-2">
            Kategori
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Category)
        </dd>
        <dt class = "col-sm-2">
            Aktiv
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsActive)
        </dd>
        <dt class = "col-sm-2">
            Skapad
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedAt)
        </dd>
        <dt class = "col-sm-2">
            Uppdaterad
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UpdatedAt)
        </dd>
        <dt class = "col-sm-2">
            Företag
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Company.Name)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Redigera</a> |
    <a asp-controller="Service" asp-action="Index" asp-route-companyId="@Model?.CompanyId">Tillbaka till lista</a>
</div>
