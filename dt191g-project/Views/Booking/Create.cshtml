@model dt191g_project.Models.Booking

@{
    ViewData["Title"] = "Skapa bokning";
}

<div class="container my-4">
    <h1>Skapa bokning</h1>
    <h4>Bokningsuppgifter</h4>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <input type="hidden" name="companyId" value="@ViewBag.CompanyId" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="ServiceId" class="form-label">Tjänst</label>
                    <select asp-for="ServiceId" id="ServiceSelect" class="form-select" asp-items="ViewBag.ServiceId">
                        <option value="">-- Välj tjänst --</option>
                    </select>
                    <span asp-validation-for="ServiceId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TimeSlotId" class="form-label">Tidslucka</label>
                    <select asp-for="TimeSlotId" id="TimeSlotSelect" class="form-select" disabled>
                        <option value="">-- Välj en tjänst ovan först --</option>
                    </select>
                    <span asp-validation-for="TimeSlotId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CustomerName" class="form-label">Kundnamn</label>
                    <input asp-for="CustomerName" class="form-control" placeholder="För- och efternamn" />
                    <span asp-validation-for="CustomerName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CustomerEmail" class="form-label">E-postadress</label>
                    <input asp-for="CustomerEmail" class="form-control" type="email" placeholder="namn@exempel.se" />
                    <span asp-validation-for="CustomerEmail" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CustomerPhone" class="form-label">Telefonnummer</label>
                    <input asp-for="CustomerPhone" class="form-control" placeholder="070-123 45 67" />
                    <span asp-validation-for="CustomerPhone" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label">Anteckningar / Önskemål</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Skapa bokning</button>
                    <a asp-action="Index"
                       asp-route-companyId="@ViewBag.CompanyId"
                       class="btn btn-secondary">
                        Tillbaka till listan
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const serviceSelect = document.getElementById('ServiceSelect');
            const timeSlotSelect = document.getElementById('TimeSlotSelect');

            const selectedSlotId = "@(Model != null && Model.TimeSlotId > 0 ? Model.TimeSlotId.ToString() : "")";

            async function loadTimeSlots(serviceId, targetSlotId) {
                if (!serviceId) {
                    timeSlotSelect.innerHTML = '<option value="">-- Välj en tjänst ovan först --</option>';
                    timeSlotSelect.disabled = true;
                    return;
                }

                timeSlotSelect.innerHTML = '<option value="">-- Laddar lediga tider... --</option>';
                timeSlotSelect.disabled = true;

                try {
                    const slotParam = targetSlotId ? targetSlotId : "";
                    const response = await fetch(`/Booking/GetTimeSlotsByService?serviceId=${serviceId}&currentSlotId=${slotParam}`);

                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }

                    const timeSlots = await response.json();

                    if (!timeSlots || timeSlots.length === 0) {
                        timeSlotSelect.innerHTML = '<option value="">Inga lediga tidsluckor hittades</option>';
                        timeSlotSelect.disabled = true;
                        return;
                    }

                    timeSlotSelect.innerHTML = '<option value="">-- Välj tidsluckor --</option>';

                    timeSlots.forEach(slot => {
                        const option = document.createElement('option');
                        option.value = slot.id;
                        option.textContent = slot.displayText;

                        if (targetSlotId && String(slot.id) === String(targetSlotId)) {
                            option.selected = true;
                        }

                        timeSlotSelect.appendChild(option);
                    });

                    timeSlotSelect.disabled = false;
                } catch (error) {
                    console.error('Fel vid hämtning av tidsluckor:', error);
                    timeSlotSelect.innerHTML = '<option value="">Kunde inte hämta tider</option>';
                    timeSlotSelect.disabled = true;
                }
            }

            // --- ÄNDRING HÄR ---
            // Kör funktionen direkt om en tjänst är förvald i listan
            if (serviceSelect && serviceSelect.value) {
                loadTimeSlots(serviceSelect.value, selectedSlotId);
            }

            // Lyssna på ändringar
            if (serviceSelect) {
                serviceSelect.addEventListener('change', function () {
                    loadTimeSlots(this.value, null);
                });
            }
        });
    </script>
}