@model IEnumerable<dt191g_project.Models.Booking>

@{
    ViewData["Title"] = "Bokningar";
}

<h1>Bokningar</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Skapa en bokning</a>
</p>

@if (!Model.Any(b => b.Status == "Bekräftad" || b.Status == "Confirmed"))
{
    <div class="alert alert-info">
        Det finns inga bekräftade bokningar att visa.
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Kundnamn</th>
                <th>E-post</th>
                <th>Telefon</th>
                <th>Anteckningar</th>
                <th>Status</th>
                <th>Skapad</th>
                <th>Uppdaterad</th>
                <th>Tjänst</th>
                <th>Tidslucka</th>
                <th>Åtgärder</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                @if (item.Status == "Bekräftad" || item.Status == "Confirmed")
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.CustomerName)</td>
                        <td>@Html.DisplayFor(modelItem => item.CustomerEmail)</td>
                        <td>@Html.DisplayFor(modelItem => item.CustomerPhone)</td>
                        <td>@Html.DisplayFor(modelItem => item.Notes)</td>
                        <td>
                            <span class="badge bg-success">@item.Status</span>
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
                        <td>@Html.DisplayFor(modelItem => item.UpdatedAt)</td>
                        <td>@(item.Service?.Title ?? "Ej angiven")</td>
                        <td>
                            @(item.TimeSlot != null ? $"{item.TimeSlot.StartTime:yyyy-MM-dd HH:mm} - {item.TimeSlot.EndTime:HH:mm}" : "N/A")
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id">Redigera</a> |
                            <a asp-action="Details" asp-route-id="@item.Id">Detaljer</a> |
                            <a asp-action="Delete" asp-route-id="@item.Id">Ta bort</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}