@model dt191g_project.Models.TimeSlot

@{
    ViewData["Title"] = "Skapa tidslucka";
    var minTimeStr = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
}

<div class="container my-4">
    <h1>Skapa tidslucka</h1>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                <input type="hidden" asp-for="CompanyId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="ServiceId" class="form-label fw-bold">Tjänst</label>
                    <select asp-for="ServiceId" class="form-select" asp-items="@(ViewBag.Services ?? new SelectList(Enumerable.Empty<SelectListItem>()))">
                        <option value="">-- Välj tjänst --</option>
                    </select>
                    <span asp-validation-for="ServiceId" class="text-danger"></span>
                </div>

                <!-- Starttid -->
                <div class="mb-3">
                    <label asp-for="StartTime" class="form-label fw-bold">Starttid</label>
                    <input asp-for="StartTime"
                           type="datetime-local"
                           class="form-control"
                           value="@(Model?.StartTime != default ? Model.StartTime.ToString("yyyy-MM-ddTHH:mm") : DateTime.Now.ToString("yyyy-MM-ddTHH:mm"))"
                           min="@minTimeStr"
                           step="60" />
                    <span asp-validation-for="StartTime" class="text-danger"></span>
                </div>

                <!-- Sluttid -->
                <div class="mb-3">
                    <label asp-for="EndTime" class="form-label fw-bold">Sluttid</label>
                    <input asp-for="EndTime"
                           type="datetime-local"
                           class="form-control"
                           value="@(Model?.EndTime != default ? Model.EndTime.ToString("yyyy-MM-ddTHH:mm") : DateTime.Now.AddHours(1).ToString("yyyy-MM-ddTHH:mm"))"
                           min="@minTimeStr"
                           step="60" />
                    <span asp-validation-for="EndTime" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="IsBooked" />
                    <label class="form-check-label" asp-for="IsBooked">Är tidsluckan bokad?</label>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Skapa tidslucka</button>
                    <a asp-action="Index" asp-route-companyId="@Model?.CompanyId" class="btn btn-secondary ms-2">Tillbaka till listan</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}