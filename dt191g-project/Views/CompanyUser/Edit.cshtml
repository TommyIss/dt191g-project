@model dt191g_project.Models.CompanyUser

@{
    ViewData["Title"] = "Redigera medarbetare";
}

<h1>Redigera medarbetare</h1>
<hr />

<div class="row">
    <div class="col-md-5">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <!-- Dolda fält -->
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CompanyId" />
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="CreatedAt" />

            <!-- Info om användaren (Skrivskyddad) -->
            <div class="form-group mb-3">
                <label class="form-label">Användare (E-post)</label>
                <input class="form-control" value="@(Model.User?.UserName ?? Model.User?.Email ?? Model.UserId)" disabled />
                <small class="form-text text-muted">Användarkopplingen kan inte ändras.</small>
            </div>

            <!-- Välj Roll -->
            <div class="form-group mb-3">
                <label asp-for="Role" class="form-label">Roll i företaget</label>
                <select asp-for="Role" class="form-control">
                    <option value="Employee">Medarbetare</option>
                    <option value="Admin">Admin</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <!-- Knappar -->
            <div class="form-group mt-3">
                <input type="submit" value="Spara ändringar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Tillbaka till listan</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}